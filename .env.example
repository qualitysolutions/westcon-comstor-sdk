# Copy to .env (which is gitignored) and fill in the values Westcon issued you.
# Never commit the real .env.

# ---------------------------------------------------------------------------
# Which environment to use: "prod" (default) or "uat". The gateway URL is chosen
# automatically from this (prod -> api.westconcomstor.com,
# uat -> westconapiuat.azure-api.net). Keys are per-environment.
# ---------------------------------------------------------------------------
WESTCON_ENV=uat

# ---------------------------------------------------------------------------
# Option A (simple): one active set of generic keys. Swap these when you switch env.
# ---------------------------------------------------------------------------
WESTCON_CLIENT_ID=
WESTCON_CLIENT_SECRET=
WESTCON_RESOURCE=
WESTCON_SUBSCRIPTION_KEY=
WESTCON_PARTNER_KEY=
# Optional: defaults to Westcon-Comstor's Azure AD tenant (the OAuth authority).
# Set only to override the token-endpoint tenant.
# WESTCON_TENANT_ID=

# ---------------------------------------------------------------------------
# Option B (keep BOTH environments at once): set per-environment values and just
# flip WESTCON_ENV above. Environment-specific vars win over the generic ones.
# ---------------------------------------------------------------------------
# UAT  (from https://westconapiuat.developer.azure-api.net/profile)
# WESTCON_UAT_CLIENT_ID=
# WESTCON_UAT_CLIENT_SECRET=
# WESTCON_UAT_RESOURCE=
# WESTCON_UAT_SUBSCRIPTION_KEY=
# WESTCON_UAT_PARTNER_KEY=
#
# PROD (from https://api-portal.westconcomstor.com/ -> Profile)
# WESTCON_PROD_CLIENT_ID=
# WESTCON_PROD_CLIENT_SECRET=
# WESTCON_PROD_RESOURCE=
# WESTCON_PROD_SUBSCRIPTION_KEY=
# WESTCON_PROD_PARTNER_KEY=

# Optional overrides:
# WESTCON_GATEWAY_BASE_URL=...   # only to override the auto-selected gateway
